# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL, source of truth) ---
# Async driver — used by both the app and Alembic (async migration template).
DATABASE_URL=postgresql+asyncpg://algoflow:algoflow@postgres:5432/algoflow
POSTGRES_USER=algoflow
POSTGRES_PASSWORD=algoflow
POSTGRES_DB=algoflow

# --- Redis (cache / pubsub / rate limiting, never permanent storage) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Secrets encryption (Fernet key for exchange API credentials at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-fernet-key

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Live trading kill switch (Phase 10 — must stay false until explicitly enabled) ---
ENABLE_LIVE_TRADING=false

# --- Exchange API credentials (placeholders only, used by Phase 5+ CCXT integration) ---
BINANCE_API_KEY=
BINANCE_SECRET=
